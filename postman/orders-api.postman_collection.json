{
  "info": {
    "_postman_id": "b6f6a2f0-1c1a-4a2e-9b0a-orders-api-gateway",
    "name": "Orders API - API Gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "order_service_url", "value": "http://localhost:8082", "type": "string" },
    { "key": "inventory_service_url", "value": "http://localhost:8083", "type": "string" },
    { "key": "keycloak_url", "value": "http://localhost:8081", "type": "string" },
    { "key": "client_id", "value": "postman-client", "type": "string" },
    { "key": "client_secret", "value": "PON_AQUI_TU_SECRET", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "product_id", "value": "3bb89bcb-a511-4cdd-b546-befc97973a2e", "type": "string" },
    { "key": "order_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "00 - Auth",
      "item": [
        {
          "name": "Obtener token (Keycloak)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('access_token', json.access_token);",
                  "pm.test('Token recibido', function () {",
                  "    pm.expect(json.access_token).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials", "type": "text" },
                { "key": "client_id", "value": "{{client_id}}", "type": "text" },
                { "key": "client_secret", "value": "{{client_secret}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{keycloak_url}}/realms/pedidos-realm/protocol/openid-connect/token",
              "host": ["{{keycloak_url}}"],
              "path": ["realms", "pedidos-realm", "protocol", "openid-connect", "token"]
            }
          }
        }
      ]
    },
    {
      "name": "01 - Order Service (via Gateway)",
      "item": [
        {
          "name": "Crear pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('order_id', json.id);",
                  "}",
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{product_id}}\",\n      \"quantity\": 2,\n      \"unitPrice\": 1500.00\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{gateway_url}}/api/orders",
              "host": ["{{gateway_url}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Consultar pedido",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "url": {
              "raw": "{{gateway_url}}/api/orders/{{order_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["api", "orders", "{{order_id}}"]
            }
          }
        },
        {
          "name": "Consultar historial",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "url": {
              "raw": "{{gateway_url}}/api/orders/{{order_id}}/history",
              "host": ["{{gateway_url}}"],
              "path": ["api", "orders", "{{order_id}}", "history"]
            }
          }
        },
        {
          "name": "Cancelar pedido",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "url": {
              "raw": "{{gateway_url}}/api/orders/{{order_id}}/cancel",
              "host": ["{{gateway_url}}"],
              "path": ["api", "orders", "{{order_id}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "01b - Inventory Service (via Gateway)",
      "item": [
        {
          "name": "Reservar stock (con auth)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{product_id}}\",\n  \"quantity\": 3\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{gateway_url}}/api/inventory/reserve",
              "host": ["{{gateway_url}}"],
              "path": ["api", "inventory", "reserve"]
            }
          }
        },
        {
          "name": "Reservar stock sin token (debe dar 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{product_id}}\",\n  \"quantity\": 3\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{gateway_url}}/api/inventory/reserve",
              "host": ["{{gateway_url}}"],
              "path": ["api", "inventory", "reserve"]
            }
          }
        }
      ]
    },
    {
      "name": "02 - Casos de error",
      "item": [
        {
          "name": "Crear pedido sin stock suficiente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{product_id}}\",\n      \"quantity\": 100000,\n      \"unitPrice\": 1500.00\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{gateway_url}}/api/orders",
              "host": ["{{gateway_url}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Cancelar pedido ya cancelado (debe dar 409)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "url": {
              "raw": "{{gateway_url}}/api/orders/{{order_id}}/cancel",
              "host": ["{{gateway_url}}"],
              "path": ["api", "orders", "{{order_id}}", "cancel"]
            }
          }
        },
        {
          "name": "Consultar pedido inexistente (debe dar 404)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "url": {
              "raw": "{{gateway_url}}/api/orders/00000000-0000-0000-0000-000000000000",
              "host": ["{{gateway_url}}"],
              "path": ["api", "orders", "00000000-0000-0000-0000-000000000000"]
            }
          }
        },
        {
          "name": "Request sin token (debe dar 401)",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": {
              "raw": "{{gateway_url}}/api/orders/{{order_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["api", "orders", "{{order_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "03 - Debug directo (sin Gateway)",
      "item": [
        {
          "name": "Inventory - Reservar stock (directo, sin auth)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{product_id}}\",\n  \"quantity\": 3\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{inventory_service_url}}/api/inventory/reserve",
              "host": ["{{inventory_service_url}}"],
              "path": ["api", "inventory", "reserve"]
            }
          }
        },
        {
          "name": "Order Service - Health check directo",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{order_service_url}}/actuator/health",
              "host": ["{{order_service_url}}"],
              "path": ["actuator", "health"]
            }
          }
        }
      ]
    }
  ]
}
